# Food Bite Services - Backend Environment Variables

# Supabase (use service role key on server ONLY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx

# Frontend URL for CORS - comma-separated list, e.g.:
#   FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app
# Spaces around commas are allowed and will be stripped.

# App
NODE_ENV=development
PORT=3001

# Business settings (can also be in settings table)
VAT_RATE=7.5
COOLER_DEPOSIT_KOBO=50000
DEFAULT_DELIVERY_ZONE_ID=your-lagos-mainland-zone-id